{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bus-priority-impact-studio.local/schemas/study-event-approval.v3.json",
  "title": "Bus Priority Impact Studio study-event approval receipt v3",
  "description": "Strict wire-shape mirror for a contract-compatible occurrence-v2 candidate-set-v3 receipt. A contract-blocked set rejects every receipt before these decision semantics apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactKind", "schemaVersion", "candidateSetId", "decisions"],
  "properties": {
    "artifactKind": { "const": "bp.studio.study_event_approvals.v3" },
    "schemaVersion": { "const": 3 },
    "candidateSetId": {
      "type": "string",
      "pattern": "^candidate-set-v3:[a-f0-9]{24}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "decision", "reviewer", "rationale"],
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^study-event-v2:[a-f0-9]{24}$"
          },
          "decision": { "enum": ["approved", "rejected"] },
          "reviewer": { "type": "string", "pattern": "\\S" },
          "rationale": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  }
}
