{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2023"],
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@bp/domain": ["./packages/domain/src/index.ts"],
      "@bp/sources/*": ["./packages/sources/src/*"],
      "@bp/analytics": ["./packages/analytics/src/index.ts"],
      "@bp/analytics/*": ["./packages/analytics/src/*/index.ts"],
      "@bp/applied-research": ["./packages/applied-research/src/index.ts"],
      "@bp/applied-research/*": ["./packages/applied-research/src/*/index.ts"],
      "@bp/db": ["./packages/db/src/index.ts"],
      "@bp/studio-api/contracts": ["./packages/studio-api/src/contracts/index.ts"],
      "@bp/studio-api/contracts/openapi": ["./packages/studio-api/src/contracts/openapi.ts"],
      "@bp/studio-api/client": ["./packages/studio-api/src/client/index.ts"],
      "@bp/studio-api/client/fetch": ["./packages/studio-api/src/client/fetch.ts"],
      "@bp/studio-api/server": ["./packages/studio-api/src/server/index.ts"],
      "@bp/studio-api/server/worker": ["./packages/studio-api/src/server/worker.ts"],
      "@bp/studio-api/server/scheduled": ["./packages/studio-api/src/server/scheduled.ts"],
      "@bp/studio-api/server/auth": ["./packages/studio-api/src/server/resources/auth/index.ts"],
      "@bp/studio-api/server/authoring": [
        "./packages/studio-api/src/server/resources/authoring/index.ts"
      ],
      "@bp/studio-api/server/authoring/agent": [
        "./packages/studio-api/src/server/resources/authoring/agent/index.ts"
      ],
      "@bp/studio-api/server/testing": ["./packages/studio-api/src/server/testing/index.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "types": []
  }
}
