{
  "name": "@bp/pipeline",
  "private": true,
  "type": "module",
  "description": "Local TypeScript CLI for data probes, artifact builds, and D1 seed generation.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "bun test ./test --timeout 5000",
    "sources:list": "bun run src/cli.ts sources:list",
    "sources:probe": "bun run src/cli.ts sources:probe",
    "collect:gtfs-rt": "bun run src/cli.ts collect:gtfs-rt",
    "ingest:gtfs-rt-snapshots": "bun run src/cli.ts ingest:gtfs-rt-snapshots",
    "ingest:ace-routes": "bun run src/cli.ts ingest:ace-routes",
    "ingest:ace-violations": "bun run src/cli.ts ingest:ace-violations",
    "ingest:bus-lanes": "bun run src/cli.ts ingest:bus-lanes",
    "ingest:equity-context": "bun run src/cli.ts ingest:equity-context",
    "ingest:route-catalog": "bun run src/cli.ts ingest:route-catalog",
    "ingest:route-coverage": "bun run src/cli.ts ingest:route-coverage",
    "ingest:route-trends": "bun run src/cli.ts ingest:route-trends",
    "backfill:route-ridership-trends": "bun run src/cli.ts backfill:route-ridership-trends",
    "route-readiness": "bun run src/cli.ts route-readiness",
    "route-build-plan": "bun run src/cli.ts route-build-plan",
    "route-reliability-baseline": "bun run src/cli.ts route-reliability-baseline",
    "route-equity-context": "bun run src/cli.ts route-equity-context",
    "export:d1": "bun run src/cli.ts export:d1",
    "verify:d1": "bun run src/cli.ts verify:d1",
    "ingest:route-slice": "bun run src/cli.ts ingest:route-slice",
    "ingest:route-schedules": "bun run src/cli.ts ingest:route-schedules",
    "build:hotspots": "bun run src/cli.ts build:hotspots",
    "build:ridership-profile": "bun run src/cli.ts build:ridership-profile",
    "build:speed-profile": "bun run src/cli.ts build:speed-profile",
    "build:routes": "bun run src/cli.ts build:routes",
    "build:network": "bun run src/cli.ts build:network",
    "build:planned-routes": "bun run src/cli.ts build:planned-routes",
    "compare:routes": "bun run src/cli.ts compare:routes",
    "route-batch-audit": "bun run src/cli.ts route-batch-audit",
    "build:route-brief": "bun run src/cli.ts build:route-brief",
    "build:interventions": "bun run src/cli.ts build:interventions",
    "build:bus-lanes": "bun run src/cli.ts build:bus-lanes",
    "build:schedules": "bun run src/cli.ts build:schedules",
    "build:artifacts": "bun run src/cli.ts build:artifacts"
  },
  "dependencies": {
    "@bp/analytics": "workspace:*",
    "@bp/db": "workspace:*",
    "@bp/domain": "workspace:*",
    "@bp/sources": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "gtfs-realtime-bindings": "1.1.1",
    "typescript": "catalog:"
  }
}
