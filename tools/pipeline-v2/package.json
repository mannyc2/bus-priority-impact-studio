{
  "name": "@bp/pipeline-v2",
  "private": true,
  "type": "module",
  "description": "Effect CLI rewrite of @bp/pipeline. Stage 1 pilot.",
  "exports": {
    ".": "./src/index.ts",
    "./cli/compat": "./src/cli/compat.ts",
    "./local-db-aggregates": "./src/lib/local-db-aggregates/index.ts"
  },
  "bin": {
    "pipeline": "./src/cli.ts"
  },
  "scripts": {
    "cli": "bun run src/cli.ts",
