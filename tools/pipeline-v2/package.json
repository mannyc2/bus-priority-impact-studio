    "test": "bun test ./test --timeout 5000"
  },
  "dependencies": {
    "@bp/analytics": "workspace:*",
    "@bp/db": "workspace:*",
    "@bp/domain": "workspace:*",
    "@bp/sources": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@nyc-transit-kit/soda3": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
