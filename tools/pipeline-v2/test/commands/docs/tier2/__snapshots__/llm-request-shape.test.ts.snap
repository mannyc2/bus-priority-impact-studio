                "type": "boolean",
              },
              "containsTables": {
                "type": "boolean",
              },
              "corridorsMentioned": {
                "items": {
                  "type": "string",
                },
                "maxItems": 50,
                "type": "array",
              },
              "datesMentioned": {
                "items": {
                  "type": "string",
                },
                "maxItems": 50,
                "type": "array",
              },
              "markdown": {
                "minLength": 1,
                "type": "string",
              },
              "metricHints": {
                "description": "Short visible metrics or table labels worth indexing, not unsupported analysis.",
                "items": {
                  "type": "string",
                },
                "maxItems": 50,
                "type": "array",
              },
              "pageNumber": {
                "description": "The pipeline-supplied PDF page ordinal, not the printed page number visible on the document.",
                "minimum": 1,
                "type": "integer",
              },
              "routesMentioned": {
                "items": {
                  "type": "string",
                },
                "maxItems": 50,
                "type": "array",
              },
              "sourceId": {
