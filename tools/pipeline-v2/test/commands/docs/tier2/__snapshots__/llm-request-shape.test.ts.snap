                "description": "Use for maps, charts, scanned tables, or illegible areas that need human visual review.",
                "items": {
                  "type": "string",
                },
                "maxItems": 20,
                "type": "array",
              },
            },
            "required": [
              "sourceId",
              "pageNumber",
              "markdown",
              "routesMentioned",
              "corridorsMentioned",
              "datesMentioned",
              "metricHints",
              "containsTables",
              "containsMaps",
              "containsCharts",
              "visualReviewHints",
