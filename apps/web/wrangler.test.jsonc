{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bus-priority-impact-studio-test",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-04-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GTFS_RT_SAMPLES_PER_CRON": "2",
    "GTFS_RT_SAMPLE_SECONDS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bus-priority-serving-test",
      "database_id": "bus-priority-serving-test"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "bus-priority-artifacts-test"
    },
    {
      "binding": "GTFS_RT_RAW",
      "bucket_name": "bus-priority-gtfs-rt-raw-test"
    },
    {
      "binding": "PLAN097_OPERATIONS",
      "bucket_name": "bus-priority-plan097-operations-test"
    }
  ]
}
