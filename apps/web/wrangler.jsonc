{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bus-priority-impact-studio",
  "account_id": "7aa7065a7e971d97435b3f22098d78b0",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-04-27",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v1-brief-author-agent",
      "new_sqlite_classes": ["BriefAuthorAgent"]
    },
    {
      "tag": "v2-delete-brief-author-agent",
      "deleted_classes": ["BriefAuthorAgent"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/index.html",
      "!/llms.txt",
      "!/robots.txt",
      "!/sitemap.xml"
    ]
  },
  "triggers": {
    "crons": ["* * * * *", "17 10 * * *"]
  },
  "vars": {
    "GTFS_RT_SAMPLES_PER_CRON": "2",
    "GTFS_RT_SAMPLE_SECONDS": "30",
    "PLAN097_RECOVERY_ENABLED": "true",
    "PLAN097_PREVIOUS_RELEASE_ID": "pub_20260605T183601689Z"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bus-priority-serving",
      "database_id": "d9cd87e2-1f77-44eb-b712-e834b23497b0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "bus-priority-artifacts"
    },
    {
      "binding": "GTFS_RT_RAW",
      "bucket_name": "bus-priority-gtfs-rt-raw"
    }
  ]
}
