{
  "name": "@bp/web",
  "private": true,
  "type": "module",
  "description": "React + Vite public app with Cloudflare Worker API.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run check:bundle-budget",
    "check:bundle-budget": "bun scripts/check-bundle-budget.ts",
    "build:studio-release": "bun ../../tools/pipeline-v2/src/cli.ts studio release",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:worker": "vitest --config vitest.worker.config.ts run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@bp/db": "workspace:*",
    "@bp/domain": "workspace:*",
    "@bp/studio-api": "workspace:*",
    "@cloudflare/ai-chat": "catalog:",
    "@cloudflare/codemode": "catalog:",
    "@cloudflare/shell": "catalog:",
    "@cloudflare/think": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "agents": "catalog:",
    "ai": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "es-toolkit": "catalog:",
    "lucide-react": "catalog:",
    "maplibre-gl": "catalog:",
    "pmtiles": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "recharts": "catalog:",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "catalog:",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vite": "catalog:",
    "workers-ai-provider": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
