{
  "name": "@bp/web",
  "private": true,
  "type": "module",
  "description": "React + Vite public app with Cloudflare Worker API.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run check:bundle-budget",
    "check:bundle-budget": "bun scripts/check-bundle-budget.ts",
    "build:studio-release": "bun ../../tools/pipeline-v2/src/cli.ts studio release",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:worker": "vitest --config vitest.worker.config.ts run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@bp/db": "workspace:*",
    "@bp/domain": "workspace:*",
    "@bp/studio-api": "workspace:*",
    "@cloudflare/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "es-toolkit": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "maplibre-gl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "catalog:",
    "@cloudflare/vitest-pool-workers": "file:../../vendor/npm/cloudflare-vitest-pool-workers-0.14.9-no-zod-v2.tgz",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
