node_modules/
dist/
build/
!tools/pipeline-v2/src/commands/build/
!tools/pipeline-v2/src/commands/build/**
!tools/pipeline-v2/test/commands/build/
!tools/pipeline-v2/test/commands/build/**
.wrangler/
test-results/
.dev.vars
.env
.env.*
!.env.example
.DS_Store

# Claude Code local scheduler state.
.claude/

# Vendor API specs downloaded ad hoc during integration; not source-of-truth.
geoclient-current-v2*.yaml

# Local/generated data. Keep fixtures small and intentional.
data/raw/*
data/working/*
data/artifacts/*
data/exports/*
data/local/*
# The reviewed Plan 073 documentation corpus is a pinned source input, not a
# generated serving artifact. Keep this one file commit-able while retaining
# the rest of the multi-gigabyte capture tree as local data.
!data/artifacts/docs/
data/artifacts/docs/*
!data/artifacts/docs/gap-roadmap-docs-2026-05-25/
data/artifacts/docs/gap-roadmap-docs-2026-05-25/*
!data/artifacts/docs/gap-roadmap-docs-2026-05-25/intervention-records-corpus-v3-reviewed-2026-05-27.json
# Keep the evidence-funnel handoff report reviewable in version control while
# all machine-sized study artifacts remain local/release-managed.
!data/artifacts/studio/
data/artifacts/studio/*
!data/artifacts/studio/v2/
data/artifacts/studio/v2/*
!data/artifacts/studio/v2/studies/
data/artifacts/studio/v2/studies/*
!data/artifacts/studio/v2/studies/temporal-anchor-audit.md
# This compact serving release and its operator-only resolution audit are
# checked in so publication can validate both from a clean checkout.
!data/artifacts/studio/v2/interventions/
data/artifacts/studio/v2/interventions/*
!data/artifacts/studio/v2/interventions/public-episodes.json
!data/artifacts/quality/
data/artifacts/quality/*
!data/artifacts/quality/intervention-episode-resolution.json
# Operational run logs, PIDs, and scratch from local backfill runners.
data/ops/*
data/ops/backfills/
!data/raw/.gitkeep
!data/working/.gitkeep
!data/artifacts/.gitkeep
!data/exports/.gitkeep
!data/local/.gitkeep

# Local databases and analysis outputs.
*.sqlite
*.sqlite3
*.db
*.duckdb
*.parquet
*.jsonl
*.ndjson
*.geojson
*.pmtiles
*.mbtiles
*.csv
*.zip

# Fixtures are intentionally commit-able even when they use data-file extensions.
!data/fixtures/
!data/fixtures/**
!tools/pipeline-v2/test/fixtures/**/*.jsonl
*.sqlite-shm
*.sqlite-wal

# Full source captures are local by default. Commit small probe metadata
# under knowledge/raw/metadata, and put large source datasets under data/raw.
knowledge/raw/downloads/*
!knowledge/raw/downloads/.gitkeep

# TanStack Start local build cache.
apps/web/.tanstack/

# Tool caches.
.repos/effect
.cache/
.temp/
.stryker-tmp/
**/.stryker-tmp/
tools/pipeline/test/.tmp-*/
*.tsbuildinfo

# Claude Code personal/local state.
CLAUDE.local.md
.claude/settings.local.json
.claude/agent-memory-local/
.gstack/
