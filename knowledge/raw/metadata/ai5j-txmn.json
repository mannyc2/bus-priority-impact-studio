    "queryString": "SELECT\n  `valid_from` AS `valid_from`,\n  `valid_to` AS `valid_to`,\n  `in_effect` AS `in_effect`,\n  `route_id` AS `route_id`,\n  `route_short_name` AS `route_short_name`,\n  `route_long_name` AS `route_long_name`,\n  `route_description` AS `route_description`,\n  `route_color` AS `route_color`,\n  `stop_id` AS `stop_id`,\n  `stop_name` AS `stop_name`,\n  `direction_id` AS `direction_id`,\n  `direction` AS `direction`,\n  `revenue_stop` AS `revenue_stop`,\n  `timepoint` AS `timepoint`,\n  `boarding` AS `boarding`,\n  `alighting` AS `alighting`,\n  `is_cbd` AS `is_cbd`,\n  `latitude` AS `latitude`,\n  `longitude` AS `longitude`,\n  `bundle` AS `bundle`,\n  `georeference` AS `georeference`\nWHERE caseless_eq(`in_effect`, \"true\")",
