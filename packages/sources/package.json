{
  "name": "@bp/sources",
  "private": true,
  "type": "module",
  "description": "Public data source adapters for MTA, Socrata, and NYC DOT.",
  "exports": {
    ".": "./src/index.ts",
    "./socrata": "./src/socrata/index.ts",
    "./mta": "./src/mta/index.ts",
    "./nyc-dot": "./src/nyc-dot/index.ts",
    "./nyc-public-data": "./src/nyc-public-data/index.ts",
    "./nyc-geoclient": "./src/nyc-geoclient/index.ts",
    "./noaa": "./src/noaa/index.ts",
    "./census": "./src/census/index.ts",
    "./registry": "./src/registry/index.ts",
    "./probes": "./src/probes/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "bun test ./test --timeout 5000"
  },
  "dependencies": {
    "@bp/domain": "workspace:*",
    "gtfs-realtime-bindings": "1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
