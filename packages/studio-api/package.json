{
  "name": "@bp/studio-api",
  "private": true,
  "type": "module",
  "description": "Framework-neutral Studio REST contracts, client, and explicit Cloudflare server entrypoints.",
  "exports": {
    "./contracts": "./src/contracts/index.ts",
    "./contracts/openapi": "./src/contracts/openapi.ts",
    "./client": "./src/client/index.ts",
    "./client/fetch": "./src/client/fetch.ts",
    "./server": "./src/server/index.ts",
    "./server/worker": "./src/server/worker.ts",
    "./server/scheduled": "./src/server/scheduled.ts",
    "./server/testing": "./src/server/testing/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "bun test ./test --timeout 5000"
  },
  "dependencies": {
    "@bp/db": "workspace:*",
    "@bp/domain": "workspace:*",
    "@nyc-transit-kit/compat": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
