{
  "name": "@bp/db",
  "private": true,
  "type": "module",
  "description": "D1/SQLite serving schema, migrations, and read repositories.",
  "exports": {
    ".": "./src/index.ts",
    "./d1": "./src/d1/index.ts",
    "./d1/bun-sqlite": "./src/d1/bun-sqlite.ts",
    "./d1/schema": "./src/d1/schema.ts",
    "./d1/validation": "./src/d1/validation.ts",
    "./pg": "./src/pg/index.ts",
    "./pg/schema": "./src/pg/schema.ts",
    "./shared": "./src/shared/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit --pretty false",
    "db:generate:d1": "drizzle-kit generate --config drizzle.config.d1.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:migrate:d1:local": "wrangler d1 migrations apply bus-priority-serving --local --config wrangler.d1.jsonc",
    "db:migrate:d1:remote": "wrangler d1 migrations apply bus-priority-serving --remote --config wrangler.d1.jsonc",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "bun test ./test --timeout 5000"
  },
  "dependencies": {
    "@bp/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "wrangler": "catalog:",
    "typescript": "catalog:"
  }
}
