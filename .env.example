MTA_BUS_TIME_API_KEY=
# R2 S3-compatible credentials for `bun run publish:serving-release`.
# Mint at https://dash.cloudflare.com/<account-id>/r2/api-tokens (Create User API Token).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Pioneer OpenAI-compatible inference for codemode / Ralph runs.
PIONEER_API_KEY=
# Optional override; defaults to https://api.pioneer.ai/v1.
PIONEER_BASE_URL=

# Other LLM providers used by local pipeline commands.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
