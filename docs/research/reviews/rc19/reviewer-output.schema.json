{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "batchId",
    "candidateSetId",
    "decisionCount",
    "countsByRecommendation",
    "decisions",
    "reviewNotes"
  ],
  "properties": {
    "batchId": { "type": "string" },
    "candidateSetId": {
      "type": "string",
      "const": "candidate-set-v2:1810cf792be7e2346b335fb5"
    },
    "decisionCount": { "type": "integer", "minimum": 0 },
    "countsByRecommendation": {
      "type": "object",
      "required": ["recommend_approve", "recommend_reject", "needs_followup"],
      "properties": {
        "recommend_approve": { "type": "integer", "minimum": 0 },
        "recommend_reject": { "type": "integer", "minimum": 0 },
        "needs_followup": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidateId",
          "identity",
          "recommendation",
          "rationale",
          "gates"
        ],
        "properties": {
          "candidateId": { "type": "string" },
          "identity": { "type": "string" },
          "recommendation": {
            "type": "string",
            "enum": ["recommend_approve", "recommend_reject", "needs_followup"]
          },
          "rationale": { "type": "string", "minLength": 1 },
          "gates": {
            "type": "object",
            "required": [
              "evidenceScope",
              "date",
              "spine",
              "outcome",
              "conflict",
              "confounder"
            ],
            "properties": {
              "evidenceScope": { "type": "string" },
              "date": { "type": "string" },
              "spine": { "type": "string" },
              "outcome": { "type": "string" },
              "conflict": { "type": "string" },
              "confounder": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "reviewNotes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
