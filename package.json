{
  "name": "bus-priority-impact-studio",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.0.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.4.0",
      "@base-ui/react": "^1.4.1",
      "@cloudflare/vite-plugin": "^1.33.1",
      "@cloudflare/workers-types": ">=4 <5",
      "@tailwindcss/vite": "^4.3.0",
      "@nyc-transit-kit/compat": "0.2.0",
      "@nyc-transit-kit/contracts": "0.2.0",
      "@nyc-transit-kit/mta": "0.2.0",
      "@nyc-transit-kit/nyc-dot": "0.2.0",
      "@nyc-transit-kit/nyc-open-data": "0.2.0",
      "@nyc-transit-kit/soda3": "0.2.0",
      "@tanstack/react-router": "^1.170.4",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@types/bun": "^1.3.12",
      "@vitejs/plugin-react": "^6.0.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-kit": "1.0.0-rc.3",
      "es-toolkit": "^1.47.0",
      "@effect/platform-bun": "4.0.0-beta.92",
      "effect": "4.0.0-beta.92",
      "lucide-react": "^1.16.0",
      "maplibre-gl": "^5.24.0",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "recharts": "^3.2.0",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.0",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.0",
      "vite": "^8.0.10",
      "vitest": "^4.1.0",
      "wrangler": "^4.0.0"
    }
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "bun --filter @bp/web dev",
    "build": "bun --filter '@bp/*' build",
    "deploy": "bun --filter @bp/web deploy",
    "pipeline": "bun --filter @bp/pipeline-v2 cli --",
    "publish:serving-release": "scripts/publish-serving-release.sh",
    "seed:local-studio-r2": "sh scripts/seed-local-studio-r2.sh",
    "seed:local-detector-r2": "sh scripts/seed-local-studio-r2.sh bus-priority-artifacts apps/web/wrangler.jsonc data/artifacts/studio/v2/detectors/route-detector-readiness-manifest.json",
    "seed:local-capability-r2": "sh scripts/seed-local-studio-r2.sh bus-priority-artifacts apps/web/wrangler.jsonc data/artifacts/studio/v2/routes/route-capability-manifest.json",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "check": "bun run check:types && bun run check:style && bun run check:architecture && bun run test",
    "check:types": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "check:style": "biome check .",
    "check:style:write": "biome check --write .",
    "check:knowledge": "bun run tools/pipeline-v2/src/checks/check-knowledge.ts",
    "check:architecture": "bun run check:web-architecture && bun run check:design-doctrine && bun run check:claude-config",
    "check:web-architecture": "bun test tests/harness/production-boundaries.test.ts --timeout 5000",
    "check:design-doctrine": "bun test tests/harness/design-doctrine.test.ts --timeout 5000",
    "check:claude-config": "bun run tools/pipeline-v2/src/checks/check-claude-config.ts",
    "check:web-seo": "bun run tools/pipeline-v2/src/checks/check-web-seo.ts",
    "check:web-performance": "bun run tools/pipeline-v2/src/checks/check-web-performance.ts",
    "check:web-release": "bun --filter @bp/web build && bun run check:web-seo && bun run check:web-performance",
    "check:publish-completeness": "bun run tools/pipeline-v2/src/checks/check-publish-completeness.ts",
    "check:pioneer-provider": "scripts/with-repo-env.sh -- bun run tools/pipeline-v2/src/checks/check-pioneer-provider.ts",
    "env:check:llm": "scripts/with-repo-env.sh --check-llm",
    "check:prepush": "bun run check:types && bun run check:style && bun run check:architecture && bun run test:unit && bun run test:web && bun run test:worker",
    "serve:web-smoke": "bun run tools/pipeline-v2/src/checks/serve-web-smoke.ts",
    "loc": "bun run tools/pipeline-v2/src/checks/check-loc.ts",
    "test": "bun run test:unit && bun run test:web && bun run test:worker",
    "test:unit": "bun test packages tools tests --timeout 5000",
    "test:web": "bun test apps/web/test/route-scorecards apps/web/test/shared --timeout 5000",
    "test:worker": "bun --filter @bp/web test:worker",
    "test:watch": "bun test --watch",
    "db:d1:generate": "bun --filter @bp/db db:generate:d1",
    "db:local:generate": "bun --filter @bp/db db:generate:local",
    "db:local:migrate": "bun --filter @bp/db db:migrate:local",
    "db:d1:migrate:local": "bun --filter @bp/db db:migrate:d1:local",
    "db:d1:migrate:remote": "bun --filter @bp/db db:migrate:d1:remote"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
