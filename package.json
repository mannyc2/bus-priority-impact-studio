{
  "name": "bus-priority-impact-studio",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.0.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.4.0",
      "@base-ui/react": "^1.4.1",
      "@cloudflare/vite-plugin": "^1.33.1",
      "@cloudflare/vitest-pool-workers": "^0.14.9",
      "@cloudflare/workers-types": ">=4 <5",
      "@tailwindcss/vite": "^4.3.0",
      "@tanstack/react-router": "^1.170.4",
      "@tanstack/router-plugin": "^1.168.6",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@types/bun": "^1.3.12",
      "@vitejs/plugin-react": "^6.0.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "drizzle-zod": "^0.8.3",
      "lucide-react": "^1.16.0",
      "maplibre-gl": "^5.24.0",
      "pmtiles": "^4.4.1",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "shadcn": "^4.7.0",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.0",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.0",
      "vite": "^8.0.10",
      "vitest": "^4.1.0",
      "wrangler": "^4.0.0",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "dev": "bun --filter @bp/web dev",
    "build": "bun --filter '@bp/*' build",
    "deploy": "bun --filter @bp/web deploy",
    "publish:serving-release": "scripts/publish-serving-release.sh",
    "pull:gtfs-rt-r2-run": "scripts/pull-gtfs-rt-r2-run.sh",
    "check": "bun run check:types && bun run check:style && bun run check:architecture && bun run test",
    "check:types": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "check:style": "biome check .",
    "check:style:write": "biome check --write .",
    "check:knowledge": "bun run tools/pipeline/src/checks/check-knowledge.ts",
    "check:pipeline-v1": "bun --filter @bp/pipeline check:pipeline-v1",
    "check:prepush": "bun run check:types && bun run check:style && bun run check:architecture && bun run test:unit && bun run test:web && bun run test:worker",
    "test": "bun run test:unit && bun run test:web && bun run test:worker",
    "test:unit": "bun test packages tools tests --timeout 5000",
    "test:web": "bun test apps/web/test/route-scorecards apps/web/test/shared --timeout 5000",
    "test:worker": "bun --filter @bp/web test:worker",
    "test:watch": "bun test --watch",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "sources:list": "bun --filter @bp/pipeline sources:list",
    "sources:probe": "bun --filter @bp/pipeline sources:probe",
    "collect:gtfs-rt": "bun --filter @bp/pipeline collect:gtfs-rt",
    "ingest:gtfs-rt-snapshots": "bun --filter @bp/pipeline ingest:gtfs-rt-snapshots",
    "import:gtfs-rt-r2-manifests": "bun --filter @bp/pipeline import:gtfs-rt-r2-manifests",
    "gtfs-rt:preflight": "bun --filter @bp/pipeline gtfs-rt:preflight",
    "gtfs-rt:run-status": "bun --filter @bp/pipeline gtfs-rt:run-status",
    "check:route-speed-availability": "bun --filter @bp/pipeline check:route-speed-availability",
    "check:bus-observatory-gtfs-rt": "bun --filter @bp/pipeline check:bus-observatory-gtfs-rt",
    "import:bus-observatory-gtfs-rt": "bun --filter @bp/pipeline import:bus-observatory-gtfs-rt",
    "import:bus-observatory-reliability-summary": "bun --filter @bp/pipeline import:bus-observatory-reliability-summary",
    "import:bus-observatory-headway-samples": "bun --filter @bp/pipeline import:bus-observatory-headway-samples",
    "plan:source-refresh": "bun --filter @bp/pipeline plan:source-refresh",
    "ingest:ace-routes": "bun --filter @bp/pipeline ingest:ace-routes",
    "ingest:ace-violations": "bun --filter @bp/pipeline ingest:ace-violations",
    "ingest:bus-lanes": "bun --filter @bp/pipeline ingest:bus-lanes",
    "ingest:equity-context": "bun --filter @bp/pipeline ingest:equity-context",
    "ingest:route-catalog": "bun --filter @bp/pipeline ingest:route-catalog",
    "ingest:route-coverage": "bun --filter @bp/pipeline ingest:route-coverage",
    "ingest:route-trends": "bun --filter @bp/pipeline ingest:route-trends",
    "backfill:route-ridership-trends": "bun --filter @bp/pipeline backfill:route-ridership-trends",
    "route-readiness": "bun --filter @bp/pipeline route-readiness",
    "route-build-plan": "bun --filter @bp/pipeline route-build-plan",
    "route-reliability-baseline": "bun --filter @bp/pipeline route-reliability-baseline",
    "build:observed-headways": "bun --filter @bp/pipeline build:observed-headways",
    "route-observed-reliability": "bun --filter @bp/pipeline route-observed-reliability",
    "route-intervention-evaluation": "bun --filter @bp/pipeline route-intervention-evaluation",
    "corridor-model": "bun --filter @bp/pipeline corridor-model",
    "evaluation-artifacts": "bun --filter @bp/pipeline evaluation-artifacts",
    "map-artifacts": "bun --filter @bp/pipeline map-artifacts",
    "brief-artifacts": "bun --filter @bp/pipeline brief-artifacts",
    "route-equity-context": "bun --filter @bp/pipeline route-equity-context",
    "export:d1": "bun --filter @bp/pipeline export:d1",
    "verify:d1": "bun --filter @bp/pipeline verify:d1",
    "finalize:pipeline-v1": "bun --filter @bp/pipeline finalize:pipeline-v1",
    "db:d1:generate": "bun --filter @bp/db db:generate:d1",
    "db:local:generate": "bun --filter @bp/db db:generate:local",
    "db:local:migrate": "bun --filter @bp/db db:migrate:local",
    "db:d1:migrate:local": "bun --filter @bp/db db:migrate:d1:local",
    "db:d1:migrate:remote": "bun --filter @bp/db db:migrate:d1:remote",
    "ingest:m1": "bun --filter @bp/pipeline ingest:m1",
    "ingest:m1-schedules": "bun --filter @bp/pipeline ingest:m1-schedules",
    "hotspots:m1": "bun --filter @bp/pipeline hotspots:m1",
    "ridership-profile:m1": "bun --filter @bp/pipeline ridership-profile:m1",
    "speed-profile:m1": "bun --filter @bp/pipeline speed-profile:m1",
    "build:routes": "bun --filter @bp/pipeline build:routes",
    "build:planned-routes": "bun --filter @bp/pipeline build:planned-routes",
    "build:network": "bun --filter @bp/pipeline build:network",
    "compare:routes": "bun --filter @bp/pipeline compare:routes",
    "route-batch-audit": "bun --filter @bp/pipeline route-batch-audit",
    "route-brief:m1": "bun --filter @bp/pipeline route-brief:m1",
    "interventions:m1": "bun --filter @bp/pipeline interventions:m1",
    "bus-lanes:m1": "bun --filter @bp/pipeline bus-lanes:m1",
    "schedules:m1": "bun --filter @bp/pipeline schedules:m1",
    "artifacts:m1": "bun --filter @bp/pipeline artifacts:m1",
    "check:architecture": "bun run check:web-architecture && bun run check:claude-config",
    "check:web-architecture": "bun run tools/pipeline/src/checks/check-web-architecture.ts",
    "check:claude-config": "bun run tools/pipeline/src/checks/check-claude-config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
