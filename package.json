{
  "name": "bus-priority-impact-studio",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.0.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.4.0",
      "@cloudflare/vite-plugin": "^1.33.1",
      "@cloudflare/vitest-pool-workers": "^0.14.9",
      "@cloudflare/workers-types": ">=4 <5",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@types/bun": "^1.3.12",
      "@vitejs/plugin-react": "^6.0.1",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "typescript": "^6.0.0",
      "vite": "^8.0.10",
      "vitest": "^4.1.0",
      "wrangler": "^4.0.0",
      "zod": "^4.1.0"
    }
  },
  "scripts": {
    "dev": "bun --filter @bp/web dev",
    "build": "bun --filter '@bp/*' build",
    "deploy": "bun --filter @bp/web deploy",
    "check": "bun run check:types && bun run check:style && bun run test",
    "check:types": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "check:style": "biome check .",
    "check:style:write": "biome check --write .",
    "check:knowledge": "bun run tools/pipeline/src/check-knowledge.ts",
    "check:prepush": "bun run check:types && bun run check:style && bun run test:unit && bun run test:worker",
    "test": "bun run test:unit && bun run test:worker",
    "test:unit": "bun test packages tools tests --timeout 5000",
    "test:worker": "bun --filter @bp/web test:worker",
    "test:watch": "bun test --watch",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "sources:list": "bun --filter @bp/pipeline sources:list",
    "sources:probe": "bun --filter @bp/pipeline sources:probe",
    "ingest:m1": "bun --filter @bp/pipeline ingest:m1",
    "hotspots:m1": "bun --filter @bp/pipeline hotspots:m1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
